<resources>
    <!-- Base application theme. -->
    <style name="Theme.BSUIRSchedule" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/BSUIR_blue</item>
        <item name="colorPrimaryVariant">@color/BSUIR_light_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/BSUIR_blue</item>
        <item name="colorSecondaryVariant">@color/BSUIR_light_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Customize your theme here. -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
        <item name="android:navigationBarColor">@color/BSUIR_blue</item>
        <item name="android:editTextColor">@android:color/white</item>
        <item name="android:colorControlNormal">@color/white</item>
        <item name="android:dialogTheme">@style/Theme.DialogFullScreen</item>

    </style>

</resources>